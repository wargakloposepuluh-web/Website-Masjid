generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Setting {
  id                    Int      @id @default(1)
  namaOrganisasi        String   @default("DEWAN KEMAKMURAN MASJID (DKM) AL-MUHAJIRIN")
  alamatOrganisasi      String   @default("Jl. Raya Utama No. 123, Kelurahan Damai, Kec. Sukamaju, Kota Sejahtera")
  kontakOrganisasi      String   @default("Telp: (021) 555-1234 | Email: dkm.almuhajirin@gmail.com | Website: www.masjidalmuhajirin.org")
  kopType               String   @default("text") // "text" | "image"
  kopImageUrl           String?
  logoKiriUrl           String?
  logoKananUrl          String?
  garisKop              Boolean  @default(true)
  marginTop             Float    @default(2.0) // cm
  marginBottom          Float    @default(2.0) // cm
  marginLeft            Float    @default(2.5) // cm
  marginRight           Float    @default(2.0) // cm
  fontFamily            String   @default("Times New Roman")
  fontSize              Int      @default(12) // pt
  lineHeight            Float    @default(1.3)
  paragrafSpacing       Float    @default(0.8) // rem
  formatNomorSurat      String   @default("{nomor}/PM-BM/{kode}/{bulan}/{tahun}")
  kotaSurat             String   @default("Kota Sejahtera")
  defaultSalamPembuka   String   @default("Assalamu'alaikum Warahmatullahi Wabarakatuh,")
  defaultKalimatPembuka String   @default("Puji syukur kehadirat Allah SWT yang senantiasa melimpahkan rahmat, taufik, dan hidayah-Nya kepada kita semua. Shalawat serta salam semoga senantiasa tercurahkan kepada junjungan kita Nabi Muhammad SAW beserta keluarga, sahabat, dan para pengikutnya hingga akhir zaman.")
  defaultKalimatPenutup String   @default("Demikian surat ini kami sampaikan. Atas perhatian, dukungan, dan kerja sama Bapak/Ibu/Saudara/i sekalian, kami haturkan terima kasih yang sebesar-besarnya. Jazakumullah khairan katsiran.")
  defaultSalamPenutup   String   @default("Wassalamu'alaikum Warahmatullahi Wabarakatuh,")
  penandatanganNama     String   @default("H. Ahmad Syarifuddin, S.Ag.")
  penandatanganJabatan  String   @default("Ketua DKM Al-Muhajirin")
  penandatanganNama2    String?  @default("Ustadz Muhammad Rizqi, M.Pd.")
  penandatanganJabatan2 String?  @default("Sekretaris DKM")
  ttdImageUrl           String?
  ttdImage2Url          String?
  stempelImageUrl       String?
  stempelPosisiX        Int      @default(-25) // px
  stempelPosisiY        Int      @default(-15) // px
  stempelUkuran         Int      @default(105) // px
  stempelOpacity        Float    @default(0.85)
  qrisImageUrl          String?
  qrisBank              String?
  qrisNama              String?
  qrisNmid              String?
  qrisRekening          String?
  qrisKeterangan        String?
  fasilitasJudul        String?  @default("Fasilitas & Pelayanan")
  fasilitasSlogan       String?  @default("Berkhidmat untuk Jamaah, Merawat Rumah Allah.")
  fasilitasFotoUrl      String?  @default("/bg_masjid.jpg")
  runningText           String?
  tampilkanSaldoRT      Boolean  @default(true)
  kecepatanRT           Int      @default(40)
  updatedAt             DateTime @updatedAt
}

model Fasilitas {
  id        Int      @id @default(autoincrement())
  judul     String
  deskripsi String
  icon      String   @default("BookOpen")
  urutan    Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SuratKeluar {
  id                   Int      @id @default(autoincrement())
  nomorSurat           String
  tanggalSurat         DateTime @default(now())
  lampiran             String   @default("-")
  perihal              String
  tujuan               String
  alamatTujuan         String?  @default("di Tempat")
  salamPembuka         String   @default("Assalamu'alaikum Warahmatullahi Wabarakatuh,")
  kalimatPembuka       String?  @default("")
  isiSurat             String
  adaAcara             Boolean  @default(false)
  acaraHariTanggal     String?
  acaraWaktu           String?
  acaraTempat          String?
  acaraAgenda          String?
  kalimatPenutup       String?  @default("")
  salamPenutup         String   @default("Wassalamu'alaikum Warahmatullahi Wabarakatuh,")
  tempatSurat          String   @default("Kota Sejahtera")
  namaPenandatangan    String
  jabatanPenandatangan String
  namaPenandatangan2   String?
  jabatanPenandatangan2 String?
  pakaiTtd             Boolean  @default(true)
  pakaiTtd2            Boolean  @default(false)
  pakaiStempel         Boolean  @default(true)
  tembusan             String?
  status               String   @default("Final") // Draft, Final, Terkirim
  catatan              String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model SuratMasuk {
  id           Int      @id @default(autoincrement())
  nomorAgenda  String
  nomorSurat   String
  tanggalSurat DateTime
  tanggalTerima DateTime @default(now())
  pengirim     String
  perihal      String
  disposisi    String?
  status       String   @default("Diterima") // Diterima, Diproses, Selesai
  fileUrl      String?
  fileName     String?
  fileSize     Int?
  keterangan   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Counter {
  id         Int    @id @default(autoincrement())
  tipe       String // SURAT_KELUAR, AGENDA_MASUK
  tahun      Int
  lastNumber Int    @default(0)

  @@unique([tipe, tahun])
}

model Pengurus {
  id         Int      @id @default(autoincrement())
  nama       String
  jabatan    String
  bidang     String
  nomorWa    String?
  keterangan String?
  urutan     Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String   // Salted PBKDF2 hash
  nama      String
  role      String   @default("SUPER_ADMIN") // "SUPER_ADMIN" | "ADMIN_SURAT" | "ADMIN_KEUANGAN"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TransaksiKeuangan {
  id           Int      @id @default(autoincrement())
  tanggal      DateTime @default(now())
  jenis        String   // "MASUK" | "KELUAR"
  kategoriKas  String   // "JARIYAH" | "INFAQ"
  nominal      Float
  keterangan   String
  buktiFotoUrl String?
  dicatatOleh  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model JadwalJumat {
  id                Int      @id @default(autoincrement())
  tanggal           DateTime
  tahun             Int
  khotib            String?
  imam              String?
  bilal             String?
  pembacaPengumuman String?
  temaKhutbah       String?
  keterangan        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([tahun])
  @@index([tanggal])
}

model KegiatanMasjid {
  id              Int      @id @default(autoincrement())
  tipe            String   // "MINGGUAN" | "BULANAN"
  namaKegiatan    String
  hari            String
  waktu           String
  tempat          String   @default("Ruang Utama Masjid Baitul Maghfirah")
  pengisi         String?
  penanggungJawab String?
  siklusBulanan   String?
  sasaranPeserta  String?
  keterangan      String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tipe])
}

model KritikSaran {
  id             Int       @id @default(autoincrement())
  nama           String    @default("Hamba Allah")
  kontak         String?   // No. WhatsApp / Email (opsional)
  kategori       String    // "SURAT" | "IBADAH" | "KEUANGAN" | "UMUM"
  judul          String?
  pesan          String
  status         String    @default("BARU") // "BARU" | "DIBACA" | "DITINDAKLANJUTI" | "ARSIP"
  tanggapan      String?   // Catatan tindak lanjut dari pengurus
  ditanggapiOleh String?
  ditanggapiPada DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([kategori])
  @@index([status])
}
